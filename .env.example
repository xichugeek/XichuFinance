# Copy to .env and replace both placeholder values before running Docker Compose.
POSTGRES_PASSWORD=replace-with-url-safe-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional: Docker Official Images on AWS ECR Public if Docker Hub is unreachable.
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:17-alpine
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim

# Optional public HTTPS package index when PyPI is unreachable. Do not put credentials here.
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
